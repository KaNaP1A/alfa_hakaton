FROM python:3.12.12-slim-bookworm@sha256:593bd06efe90efa80dc4eee3948be7c0fde4134606dd40d8dd8dbcade98e669c
COPY --from=ghcr.io/astral-sh/uv:0.13.8@sha256:5cc1805e2426484abca4ad46ea783bab281fdb225fd82d8ce6d66a81254bac85 /uv /uvx /bin/
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 \
    UV_PROJECT_ENVIRONMENT=/app/.venv \
    PYTHONPATH=/app:/app/backend:/app/05_code/src
WORKDIR /app
RUN apt-get update && apt-get install -y --no-install-recommends libgomp1=12.2.0-14+deb12u1 \
    && rm -rf /var/lib/apt/lists/*
COPY docker/pyproject.toml docker/uv.lock /app/
RUN uv sync --frozen --no-dev && rm -rf /root/.cache/uv
COPY models/recommender /app/models/recommender
COPY backend /app/backend
COPY 05_code/src /app/05_code/src
COPY 05_code/scripts /app/05_code/scripts
COPY scripts/run_project.py /app/scripts/run_project.py
COPY data/demo_catalog.json /app/data/demo_catalog.json
COPY docker/start_api.py docker/ensure_model.py /app/docker/
RUN python /app/docker/ensure_model.py \
    && useradd --create-home app \
    && mkdir -p /data \
    && chown app:app /data
USER app
EXPOSE 8080
CMD ["/app/.venv/bin/python", "/app/docker/start_api.py"]
