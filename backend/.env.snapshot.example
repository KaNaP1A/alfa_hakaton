# Generate .env.snapshot with: python3 scripts/setup_snapshot_env.py
COMPOSE_PROJECT_NAME=alfa-snapshot
POSTGRES_PASSWORD=__GENERATED_PASSWORD__
POSTGRES_PORT=55432
ALFA_DATABASE_URL=postgresql+psycopg://alfa:__GENERATED_PASSWORD__@127.0.0.1:55432/alfa_snapshot
ALFA_CATALOG_SOURCE=postgres
ALFA_AUTO_CREATE_TABLES=false
ALFA_CATALOG_GENERATION=production-snapshot
# Lexical search over real PostgreSQL data; DB-only startup does not launch API/ML.
ALFA_RECO_MODE=demo
ALFA_RECO_URL=http://host.docker.internal:8000
ALFA_RECO_HOST_HEADER=localhost:8000
ALFA_RECO_TIMEOUT=30
ALFA_RATE_LIMIT=120
ALFA_TOKEN_TTL=86400
ALFA_CORS_ORIGINS=
