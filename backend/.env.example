POSTGRES_PASSWORD=replace-with-a-local-password
ALFA_RECO_MODE=demo
# Direct Python library: ALFA_RECO_MODE=python (install ML dependencies first)
# ALFA_RECO_CATALOG=/absolute/path/to/prepared-runtime/catalog
# For the actual algorithm: http://host.docker.internal:8000
ALFA_RECO_URL=http://host.docker.internal:8000
# Required if using the existing loopback API through a container gateway.
# ALFA_RECO_HOST_HEADER=localhost:8000
ALFA_RECO_TIMEOUT=30
ALFA_RATE_LIMIT=120
ALFA_TOKEN_TTL=86400
# Running without Docker: override if PostgreSQL is available.
# ALFA_DATABASE_URL=postgresql+psycopg://alfa:password@localhost:5432/alfa_api

# Optional separate frontend origins, comma-separated; no wildcard.
# ALFA_CORS_ORIGINS=http://localhost:5173

# Production snapshot: Docker restores only the dump, no API migrations.
POSTGRES_PORT=55432
ALFA_CATALOG_SOURCE=postgres
ALFA_AUTO_CREATE_TABLES=false
# Must match the model index generation for http/python; demo can use this label.
ALFA_CATALOG_GENERATION=production-snapshot
# Native API against the restored Docker PostgreSQL:
# ALFA_DATABASE_URL=postgresql+psycopg://alfa:password@localhost:55432/alfa_snapshot
