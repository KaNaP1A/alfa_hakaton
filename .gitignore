# Credentials and local configuration must never be committed.
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx
.secrets/
.credentials/

# User databases, backups and local derived artifacts.
*.sqlite
*.sqlite3
*.db
*.db-*
*.sql
*.dump
*.backup
*.bak
/05_code/artifacts/
/05_code/evaluation/
/models/runtime/
/models/sandbox/
/.push-algorithm/
/frontend_handoff.zip
/docs/review_evidence_2026-11-12/
/docs/EXPERT_REVIEW_2026-11-12.md

# Arbitrary exports and trained artifacts are private by default. The explicitly
# prepared data/ and models/recommender/ are the only publishable exceptions.
*.csv
*.tsv
*.xlsx
*.xls
*.xlsm
*.jsonl
!data/**/*.jsonl
*.cbm
*.safetensors
*.onnx
*.pt
*.pth
*.bin
*.gguf
*.pkl
*.pickle
*.joblib
*.npy
*.npz
!models/recommender/**/*.cbm
!models/recommender/**/*.safetensors
!models/recommender/**/*.npz

# Python environments, build output and caches.
.venv/
venv/
env/
__pycache__/
*.py[cod]
*.egg-info/
.ruff_cache/
.pytest_cache/
.mypy_cache/
.coverage
htmlcov/
build/
dist/

# Legacy local-only UI and deployment artifacts, not the tracked demo_catalog/.
/05_code/src/alfa_reco/web/
/05_code/src/alfa_reco/lab.py
/05_code/Dockerfile
/05_code/compose.yaml
/05_code/.dockerignore
/05_code/.env.example
/05_code/*.command
/05_code/scripts/container_entrypoint.py
/05_code/scripts/restore_postgres.sh
/05_code/tests/test_container_staging.py
/05_code/tests/test_lab_and_history.py
/05_code/tests/test_profile_migration.py

# OS, editor and temporary files.
.DS_Store
Thumbs.db
.idea/
.vscode/
*.log
*.tmp

# Frontend dependencies and local lockfile.
/frontend/node_modules/
/frontend/package-lock.json

# Reviewed schema migrations and a credential-free env template.
!/backend/migrations/*.sql
!/backend/.env.snapshot.example

# Local launcher state and logs.
/.run/
/models/.runtime-*/

# Local design checks and dedicated headless Chrome profiles.
/frontend/.taste-skill/
